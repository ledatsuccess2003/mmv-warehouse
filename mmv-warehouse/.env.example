# Sao chép file này thành .env rồi điền khóa dự án Supabase của bạn.
# Lấy tại: Supabase Dashboard -> Project Settings -> API
# Dùng public anon key hoặc publishable key; không dùng service_role/secret key.
# Trên Vercel, thêm cả hai biến cho Production rồi Redeploy (giá trị được chèn lúc build).
# Không có chế độ dữ liệu mẫu: thiếu cấu hình thì npm run build báo lỗi,
# npm run dev hiện màn hình "Chưa kết nối kho dữ liệu".

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
