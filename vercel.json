{
  "buildCommand": "cd mmv-warehouse && npm install && npm run build",
  "outputDirectory": "mmv-warehouse/dist",
  "installCommand": "npm ci",
  "framework": null,
  "crons": [{"path":"/api/push?dispatch=1","schedule":"0 1 * * *"}],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
